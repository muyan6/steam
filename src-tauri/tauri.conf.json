{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "春风渡",
  "version": "2.0.0",
  "identifier": "com.chunfengdu.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "春风渡 - 游戏一键入库与联机工具",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 660,
        "decorations": false,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob:; connect-src 'self' https: http: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "assets/tools/steamless/": "assets/tools/steamless/",
      "assets/libs/WebView2Loader.dll": "WebView2Loader.dll",
      "../server/data/steam_all_games.json": "steam_all_games.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
