{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "春风渡",
  "version": "1.0.0",
  "identifier": "com.chunfengdu.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "春风渡 - 游戏一键入库与联机工具",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 660,
        "decorations": false,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
